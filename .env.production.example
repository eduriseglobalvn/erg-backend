# ============================================================
# EduRise Global (ERG) - Production Environment Variables
# ============================================================
# Copy file này thành .env khi deploy production
# ⚠️ KHÔNG commit .env thật vào git!

# ---- Node ----
NODE_ENV=production
PORT=3003

# ---- JWT Secrets ----
# Generate: openssl rand -base64 64
JWT_ACCESS_SECRET=your_access_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_here_min_32_chars

# ---- Admin Default Password ----
# ⚠️ Thay đổi ngay sau khi deploy lần đầu
ADMIN_DEFAULT_PASSWORD=change_me_immediately

# ============================================================
# DATABASE LAYER - Dùng free tier services
# ============================================================

# ---- MySQL → PlanetScale (Serverless Free Tier) ----
# Tạo database tại: https://app.planetscale.com
# 1. Sign up → Create database → Copy connection string
# 2. Branching: main (prod), dev (develop)
# 3. Dùng password từ dashboard, KHÔNG dùng root password
DB_HOST=aws.connect.psdb.cloud
DB_PORT=3306
DB_USER=erg-xxxxx
DB_PASS=pscale_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DB_NAME=erg_db

# ---- MongoDB → MongoDB Atlas M0 (Free Tier) ----
# Tạo cluster tại: https://www.mongodb.com/atlas
# M0 Sandbox: 512MB, shared CPU/RAM
# 1. Sign up → Build a Database → M0 Sandbox (FREE)
# 2. Tạo user database (không dùng root/admin)
# 3. Whitelist IP: 0.0.0.0/0 (cho phép tất cả) hoặc IP server
MONGO_URL=mongodb+srv://erg_user:password@cluster0.xxxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGO_DB_NAME=erg

# ---- Redis → Redis Cloud Free (30MB, Unlimited Requests) ----
# Tạo tại: https://redis.cloud (Redis Labs)
# Free tier: 30MB, unlimited requests/day
# Hoặc Upstash Free: https://upstash.com (10K req/day)
# 1. Sign up → Create database → Copy endpoint URL
# 2. Enable TLS cho production
REDIS_HOST=redis-xxxxx.upstash.io
REDIS_PORT=6379
REDIS_PASS=xxxxxx
REDIS_TLS=true

# ============================================================
# THIRD-PARTY SERVICES
# ============================================================

# ---- Email (gửi qua SMTP hoặc API) ----
# Ví dụ: Resend (100 emails/day free), SendGrid (100 emails/day free)
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USER=resend
MAIL_PASS=re_xxxxx
MAIL_FROM=noreply@erg.edu.vn

# ---- AI Content (nếu cần) ----
# HuggingFace Inference API hoặc OpenAI
AI_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxx
AI_API_URL=https://api-inference.huggingface.co/models

# ---- File Storage ----
# Cloudflare R2 (S3-compatible, 10GB/month free)
# Hoặc AWS S3 (5GB free tier)
S3_BUCKET=erg-uploads
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=AKIAXXXXXXXXXXXXXXXX
S3_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
S3_ENDPOINT=https://xxxxxxxx.r2.cloudflarestorage.com
